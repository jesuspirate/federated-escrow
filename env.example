# ═══════════════════════════════════════════════════════════════════
# Federated Escrow — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Encryption ────────────────────────────────────────────────────
# 64-char hex key for encrypting escrow data at rest.
# Generate with: openssl rand -hex 32
# ⚠️  If you lose this key, existing escrow data becomes unrecoverable.
ESCROW_ENCRYPTION_KEY=

# ── Arbiter Allowlist ─────────────────────────────────────────────
# Comma-separated list of hex pubkeys (NOT npubs) authorized to
# join trades as arbiters. If empty, arbiter joins are OPEN.
#
# To convert npub → hex:
#   node -e "const {bech32} = require('@scure/base'); ..."
#
# Example:
#   ALLOWED_ARBITERS=abc123...,def456...
ALLOWED_ARBITERS=

# ── Fedimint (optional) ──────────────────────────────────────────
# Path to fedimint-cli binary. Required for Lightning lock/payout.
# If not set, only manual e-cash note mode is available.
# FEDIMINT_CLI=/usr/local/bin/fedimint-cli

# Data directory for fedimint client state
# FEDIMINT_DATA_DIR=/home/satoshi/.fedimint

# Federation invite code (for auto-joining on first start)
# FEDIMINT_INVITE=fed11...
